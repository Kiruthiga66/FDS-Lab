#include <stdio.h>
#include <stdlib.h>

typedef struct Node {
    int data;
    struct Node *next;
} Node;

void insertEnd(Node **tail, int value) {
    Node *node = malloc(sizeof(Node));
    node->data = value;

    if (*tail == NULL) {
        node->next = node;
        *tail = node;
    } else {
        node->next = (*tail)->next;
        (*tail)->next = node;
        *tail = node;
    }
}

void display(Node *tail) {
    if (tail == NULL) {
        printf("List is empty\n");
        return;
    }

    Node *current = tail->next;
    do {
        printf("%d -> ", current->data);
        current = current->next;
    } while (current != tail->next);
    printf("(back to head)\n");
}

int main(void) {
    Node *tail = NULL;
    int n, value;

    printf("Number of values: ");
    scanf("%d", &n);

    for (int i = 0; i < n; i++) {
        printf("Value: ");
        scanf("%d", &value);
        insertEnd(&tail, value);
    }

    display(tail);
    return 0;
}
