#include <stdio.h>
#include <stdlib.h>

typedef struct Node {
    int data;
    struct Node *left, *right;
} Node;

Node *insert(Node *root, int value) {
    if (root == NULL) {
        Node *node = malloc(sizeof(Node));
        node->data = value;
        node->left = node->right = NULL;
        return node;
    }

    if (value < root->data)
        root->left = insert(root->left, value);
    else if (value > root->data)
        root->right = insert(root->right, value);

    return root;
}

void inorder(Node *root) {
    if (root == NULL)
        return;
    inorder(root->left);
    printf("%d ", root->data);
    inorder(root->right);
}

int main(void) {
    Node *root = NULL;
    int n, value;

    printf("Number of values: ");
    scanf("%d", &n);
    for (int i = 0; i < n; i++) {
        printf("Value: ");
        scanf("%d", &value);
        root = insert(root, value);
    }

    printf("Inorder traversal: ");
    inorder(root);
    printf("\n");
    return 0;
}
