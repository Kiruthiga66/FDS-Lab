#include <stdio.h>
#define SIZE 10

int main(void) {
    int table[SIZE], n, value;

    for (int i = 0; i < SIZE; i++)
        table[i] = -1;

    printf("Number of values (maximum %d): ", SIZE);
    scanf("%d", &n);

    for (int i = 0; i < n; i++) {
        printf("Value: ");
        scanf("%d", &value);

        int index = ((value % SIZE) + SIZE) % SIZE;
        int start = index;

        while (table[index] != -1) {
            index = (index + 1) % SIZE;
            if (index == start) {
                printf("Hash table is full; could not insert %d\n", value);
                break;
            }
        }

        if (table[index] == -1)
            table[index] = value;
    }

    printf("Hash table:\n");
    for (int i = 0; i < SIZE; i++) {
        if (table[i] == -1)
            printf("Index %d: empty\n", i);
        else
            printf("Index %d: %d\n", i, table[i]);
    }

    return 0;
}
