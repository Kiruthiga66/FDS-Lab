#include <stdio.h>

int main(void) {
    int a[100], n, target, left, right, found = -1;

    printf("Number of elements: ");
    scanf("%d", &n);
    printf("Enter sorted values in ascending order:\n");
    for (int i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Value to search: ");
    scanf("%d", &target);

    left = 0;
    right = n - 1;

    while (left <= right) {
        int mid = left + (right - left) / 2;

        if (a[mid] == target) {
            found = mid;
            break;
        } else if (a[mid] < target) {
            left = mid + 1;
        } else {
            right = mid - 1;
        }
    }

    if (found == -1)
        printf("Not found\n");
    else
        printf("Found at position %d\n", found + 1);

    return 0;
}
