#include <stdio.h>
#define MAX 100

int main(void) {
    int stack[MAX], top = -1, choice, value;

    do {
        printf("\n1.Push 2.Pop 3.Display 0.Exit\nChoice: ");
        scanf("%d", &choice);

        if (choice == 1) {
            if (top == MAX - 1) {
                printf("Stack overflow\n");
            } else {
                printf("Value: ");
                scanf("%d", &value);
                stack[++top] = value;
            }
        } else if (choice == 2) {
            if (top == -1)
                printf("Stack underflow\n");
            else
                printf("Popped: %d\n", stack[top--]);
        } else if (choice == 3) {
            for (int i = top; i >= 0; i--)
                printf("%d ", stack[i]);
            printf("\n");
        }
    } while (choice != 0);

    return 0;
}
