#include <stdio.h>
#include <stdlib.h>

typedef struct Node {
    int data;
    struct Node *next;
} Node;

void insertEnd(Node **head, int value) {
    Node *node = malloc(sizeof(Node));
    node->data = value;
    node->next = NULL;

    if (*head == NULL) {
        *head = node;
        return;
    }

    Node *current = *head;
    while (current->next != NULL)
        current = current->next;
    current->next = node;
}

void display(Node *head) {
    while (head != NULL) {
        printf("%d -> ", head->data);
        head = head->next;
    }
    printf("NULL\n");
}

int main(void) {
    Node *head = NULL;
    int n, value;

    printf("Number of values: ");
    scanf("%d", &n);

    for (int i = 0; i < n; i++) {
        printf("Value: ");
        scanf("%d", &value);
        insertEnd(&head, value);
    }

    display(head);
    return 0;
}
