#include <stdio.h>

void quickSort(int a[], int low, int high) {
    if (low >= high)
        return;

    int pivot = a[high];
    int i = low - 1;

    for (int j = low; j < high; j++) {
        if (a[j] <= pivot) {
            i++;
            int temp = a[i];
            a[i] = a[j];
            a[j] = temp;
        }
    }

    int temp = a[i + 1];
    a[i + 1] = a[high];
    a[high] = temp;

    int pivotIndex = i + 1;
    quickSort(a, low, pivotIndex - 1);
    quickSort(a, pivotIndex + 1, high);
}

int main(void) {
    int a[100], n;

    printf("Number of elements: ");
    scanf("%d", &n);
    for (int i = 0; i < n; i++)
        scanf("%d", &a[i]);

    quickSort(a, 0, n - 1);

    printf("Sorted: ");
    for (int i = 0; i < n; i++)
        printf("%d ", a[i]);
    printf("\n");
    return 0;
}
