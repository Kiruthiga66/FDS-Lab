#include <stdio.h>
#define MAX 20

int graph[MAX][MAX], visited[MAX], n;

void dfs(int vertex) {
    visited[vertex] = 1;
    printf("%d ", vertex);

    for (int i = 0; i < n; i++) {
        if (graph[vertex][i] && !visited[i])
            dfs(i);
    }
}

int main(void) {
    int start;

    printf("Number of vertices: ");
    scanf("%d", &n);

    printf("Enter the adjacency matrix:\n");
    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            scanf("%d", &graph[i][j]);

    printf("Starting vertex (0 to %d): ", n - 1);
    scanf("%d", &start);

    printf("DFS: ");
    dfs(start);
    printf("\n");
    return 0;
}
