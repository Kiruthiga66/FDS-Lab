#include <stdio.h>
#define MAX 20

int main(void) {
    int graph[MAX][MAX], visited[MAX] = {0};
    int queue[MAX], n, start, front = 0, rear = 0;

    printf("Number of vertices: ");
    scanf("%d", &n);

    printf("Enter the adjacency matrix:\n");
    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            scanf("%d", &graph[i][j]);

    printf("Starting vertex (0 to %d): ", n - 1);
    scanf("%d", &start);

    queue[rear++] = start;
    visited[start] = 1;

    printf("BFS: ");
    while (front < rear) {
        int vertex = queue[front++];
        printf("%d ", vertex);

        for (int i = 0; i < n; i++) {
            if (graph[vertex][i] && !visited[i]) {
                visited[i] = 1;
                queue[rear++] = i;
            }
        }
    }

    printf("\n");
    return 0;
}
