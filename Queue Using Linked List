#include <stdio.h>
#include <stdlib.h>

typedef struct Node {
    int data;
    struct Node *next;
} Node;

int main(void) {
    Node *front = NULL, *rear = NULL;
    int choice, value;

    do {
        printf("\n1.Enqueue 2.Dequeue 3.Display 0.Exit\nChoice: ");
        scanf("%d", &choice);

        if (choice == 1) {
            Node *node = malloc(sizeof(Node));
            if (node == NULL) {
                printf("Memory allocation failed\n");
                continue;
            }

            printf("Value: ");
            scanf("%d", &value);
            node->data = value;
            node->next = NULL;

            if (rear == NULL)
                front = rear = node;
            else {
                rear->next = node;
                rear = node;
            }
        } else if (choice == 2) {
            if (front == NULL) {
                printf("Queue is empty\n");
            } else {
                Node *temp = front;
                printf("Removed: %d\n", temp->data);
                front = front->next;
                if (front == NULL)
                    rear = NULL;
                free(temp);
            }
        } else if (choice == 3) {
            for (Node *current = front; current != NULL; current = current->next)
                printf("%d ", current->data);
            printf("\n");
        }
    } while (choice != 0);

    return 0;
}
